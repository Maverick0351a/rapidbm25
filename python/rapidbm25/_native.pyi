"""Type hints for the Rust extension. The implementation is rapidbm25._native."""
from typing import Any, Optional, Sequence

class Index:
    corpus_size: int
    avgdl: float
    average_idf: float
    mapped: bool
    fixes: bool
    k1: float
    b: float
    epsilon: float
    delta: float
    compat: str
    class_name: str
    variant: str
    def __init__(self, corpus: Any, variant: str, k1: float, b: float, epsilon: float = ..., delta: float = ..., fixes: bool = ...) -> None: ...
    def get_scores(self, query: Any) -> Any: ...
    def get_scores_many(self, queries: Any) -> Any: ...
    def top_k(self, query: Any, k: int) -> Any: ...
    def top_n_many(self, queries: Any, k: int) -> Any: ...
    def save(self, path: str) -> None: ...
    @staticmethod
    def load(path: str, mmap: bool = False) -> "Index": ...
    def to_bytes(self) -> bytes: ...
    @staticmethod
    def from_bytes(data: bytes) -> "Index": ...
    def doc_len_list(self) -> list: ...
    def idf_dict(self) -> dict: ...
    def doc_freqs_list(self) -> list: ...

class LiveIndex:
    corpus_size: int
    k1: float
    b: float
    epsilon: float
    delta: float
    fixes: bool
    variant: str
    compat: str
    def __init__(self, variant: str, k1: float, b: float, epsilon: float, delta: float, fixes: bool) -> None: ...
    def add(self, id: str, tokens: Sequence[str], text: str, meta: str) -> None: ...
    def delete(self, id: str) -> bool: ...
    def update(self, id: str, tokens: Sequence[str], text: str, meta: Optional[str] = ...) -> None: ...
    def get_scores(self, tokens: Sequence[str]) -> Any: ...
    def get_scores_many(self, queries: Sequence[Sequence[str]]) -> Any: ...
    def search(self, tokens: Sequence[str], k: int, mask: Optional[Sequence[bool]] = ...) -> list: ...
    def ids(self) -> list: ...
    def texts(self) -> list: ...
    def metas(self) -> list: ...
    def corpus(self) -> list: ...
    def save(self, path: str, tokenizer_tag: Optional[str] = ...) -> None: ...
    @staticmethod
    def load(path: str) -> tuple: ...

class Tokenizer:
    lowercase: bool
    cjk: bool
    stemmer: Optional[str]
    stop_preset: Optional[str]
    stop_custom: list
    def __init__(self, lowercase: bool = ..., stemmer: Optional[str] = ..., stopwords: Any = ..., cjk: bool = ...) -> None: ...
    def __call__(self, text: str) -> list: ...
    def tokenize(self, text: str) -> list: ...
    def tokenize_many(self, texts: Sequence[str]) -> list: ...

def top_k_of(scores: Any, k: int) -> Any: ...
